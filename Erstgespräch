<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Erstgespräch – Linden Consulting</title>
  <meta name="robots" content="noindex, nofollow">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
  <style>
    :root {
      --r:   #e42421;
      --rl:  #c11d1a;
      --rp:  #FFF0F0;
      --rm:  #FBCFCE;
      --t:   #000000;
      --tm:  #444444;
      --ts:  #777777;
      --b:   #E5E5E5;
      --bg:  #ffffff;
      --bgs: #F8F8F8;
      --rad: 10px;
      --sh:  0 2px 12px rgba(228,36,33,.07);
      --f:   'Inter', system-ui, sans-serif;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: var(--f); background: var(--bgs); color: var(--t); font-size: 15px; line-height: 1.65; min-height: 100vh; }
    /* ── HEADER ── */
    header { background: #fff; border-bottom: 1px solid var(--b); position: sticky; top: 0; z-index: 100; box-shadow: 0 1px 4px rgba(0,0,0,.06); }
    .nav-inner { max-width: 1060px; margin: 0 auto; padding: 13px 24px; display: flex; align-items: center; justify-content: space-between; }
    .nav-logo img { height: 42px; width: auto; }
    .nav-logo span { font-size: 17px; font-weight: 700; color: var(--r); }
    nav { display: flex; gap: 4px; }
    nav a { text-decoration: none; font-size: 13px; font-weight: 500; color: var(--tm); padding: 7px 11px; border-radius: 7px; transition: all .18s; }
    nav a:hover { background: var(--rp); color: var(--r); }
    nav a.cta { background: var(--r); color: #fff; font-weight: 600; }
    nav a.cta:hover { background: var(--rl); }
    /* ── HERO ── */
    .hero { background: #fff; border-bottom: 1px solid var(--b); padding: 32px 24px 28px; display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
    .hero-left { display: flex; flex-direction: column; gap: 4px; }
    .eyebrow { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .1em; color: var(--ts); }
    .hero h1 { font-size: clamp(20px, 2.8vw, 28px); font-weight: 800; line-height: 1.2; }
    .hero h1 em { color: var(--r); font-style: normal; }
    .hero-badge { display: inline-flex; align-items: center; gap: 8px; background: var(--rp); border: 1px solid var(--rm); border-radius: 8px; padding: 7px 14px; font-size: 14px; font-weight: 600; color: var(--r); margin-top: 10px; min-height: 36px; }
    .hero-badge .lbl { font-weight: 400; color: var(--ts); }
    .hero-right img { height: 50px; width: auto; }
    .hero-right p { font-size: 11px; color: var(--ts); margin-top: 5px; text-align: right; }
    @media(max-width:560px){ .hero { flex-direction: column-reverse; } .hero-right { text-align: center; } .hero-right p { text-align: center; } }
    /* ── PROGRESS ── */
    .prog-bar { background: #fff; border-bottom: 1px solid var(--b); padding: 14px 24px; }
    .prog-inner { max-width: 720px; margin: 0 auto; display: flex; align-items: center; }
    .prog-step { display: flex; align-items: center; gap: 7px; flex: 1; }
    .prog-step:last-child { flex: none; }
    .prog-dot { width: 26px; height: 26px; border-radius: 50%; border: 2px solid var(--b); background: #fff; color: var(--ts); font-size: 11px; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: all .25s; }
    .prog-dot.active { border-color: var(--r); background: var(--r); color: #fff; }
    .prog-dot.done { border-color: var(--r); background: var(--rp); color: var(--r); }
    .prog-lbl { font-size: 11px; font-weight: 500; color: var(--ts); white-space: nowrap; }
    .prog-lbl.active { color: var(--r); font-weight: 700; }
    .prog-line { flex: 1; height: 2px; background: var(--b); margin: 0 5px; transition: background .25s; }
    .prog-line.done { background: var(--rm); }
    @media(max-width:580px){ .prog-lbl { display: none; } .prog-line { margin: 0 3px; } }
    /* ── WRAP ── */
    .wrap { max-width: 740px; margin: 28px auto 80px; padding: 0 20px; }
    /* ── PANELS ── */
    .panel { display: none; }
    .panel.active { display: block; }
    /* ── CARD ── */
    .card { background: #fff; border: 1px solid var(--b); border-radius: var(--rad); padding: 26px; box-shadow: var(--sh); margin-bottom: 18px; }
    .card-title { font-size: 16px; font-weight: 700; margin-bottom: 3px; }
    .card-sub { font-size: 13px; color: var(--ts); margin-bottom: 20px; }
    /* ── FIELDS ── */
    .field { margin-bottom: 14px; }
    .field:last-child { margin-bottom: 0; }
    .field > label { display: block; font-size: 13px; font-weight: 600; color: var(--tm); margin-bottom: 5px; }
    .field > label small { font-weight: 400; color: var(--ts); }
    input[type=text], input[type=email], input[type=tel], input[type=number], input[type=date], select, textarea {
      width: 100%; background: var(--bgs); border: 1.5px solid var(--b); color: var(--t); font-family: var(--f);
      font-size: 14px; padding: 9px 12px; border-radius: 8px; outline: none; appearance: none; transition: border .18s; }
    input:focus, select:focus, textarea:focus { border-color: var(--r); background: #fff; }
    input.invalid, select.invalid { border-color: var(--r); background: var(--rp); }
    .g2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    @media(max-width:500px){ .g2 { grid-template-columns: 1fr; } }
    /* ── SEC HEADER ── */
    .sec { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .09em; color: var(--ts); margin: 20px 0 10px; display: flex; align-items: center; gap: 8px; }
    .sec::after { content: ''; flex: 1; height: 1px; background: var(--b); }
    /* ── CHECKBOXES ── */
    .chk-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 7px; }
    @media(max-width:440px){ .chk-grid { grid-template-columns: 1fr; } }
    .chk-item { display: flex; align-items: center; gap: 9px; padding: 8px 11px; background: var(--bgs); border: 1.5px solid var(--b); border-radius: 8px; cursor: pointer; transition: all .15s; user-select: none; }
    .chk-item:hover { border-color: var(--r); }
    .chk-item input[type=checkbox] { display: none; }
    .chk-box { width: 17px; height: 17px; border: 2px solid var(--b); border-radius: 4px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; transition: all .15s; }
    .chk-item input:checked ~ .chk-box { background: var(--r); border-color: var(--r); }
    .chk-item input:checked ~ .chk-box::after { content: '✓'; color: #fff; font-size: 10px; font-weight: 800; }
    .chk-item input:checked ~ .chk-lbl { color: var(--r); font-weight: 600; }
    .chk-item.sel { border-color: var(--r); background: var(--rp); }
    .chk-lbl { font-size: 13px; color: var(--tm); }
    /* ── MODULE PILLS ── */
    .pills { display: flex; flex-wrap: wrap; gap: 7px; }
    .pill { display: flex; align-items: center; gap: 5px; padding: 7px 12px; background: var(--bgs); border: 1.5px solid var(--b); border-radius: 8px; cursor: pointer; font-size: 13px; color: var(--tm); transition: all .15s; user-select: none; }
    .pill input[type=checkbox] { display: none; }
    .pill:hover { border-color: var(--r); }
    .pill.sel { border-color: var(--r); background: var(--rp); color: var(--r); font-weight: 600; }
    /* ── WERTSÄULE SECTION (Step 4) ── */
    .wert-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 14px; }
    @media(max-width:500px){ .wert-row { grid-template-columns: 1fr; } }
    .mult-card { background: var(--bgs); border: 1.5px solid var(--b); border-radius: 8px; padding: 12px 14px; display: flex; align-items: center; justify-content: space-between; }
    .mult-card .mc-label { font-size: 12px; color: var(--ts); margin-bottom: 2px; }
    .mult-card .mc-val { font-size: 15px; font-weight: 700; color: var(--t); }
    .mult-card .mc-mult { font-size: 18px; font-weight: 800; color: var(--r); }
    .mult-card.highlight { border-color: var(--rm); background: var(--rp); }
    .slider-val { text-align: center; font-size: 17px; font-weight: 700; color: var(--r); margin-bottom: 7px; }
    input[type=range] { width: 100%; accent-color: var(--r); }
    .slider-lbls { display: flex; justify-content: space-between; font-size: 11px; color: var(--ts); margin-top: 4px; }
    .price-box { background: var(--rp); border: 1.5px solid var(--rm); border-radius: var(--rad); padding: 20px; margin-top: 18px; }
    .price-box-top { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: var(--r); margin-bottom: 12px; }
    .price-phases { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 14px; }
    @media(max-width:460px){ .price-phases { grid-template-columns: 1fr; } }
    .phase-chip { background: #fff; border: 1px solid var(--rm); border-radius: 8px; padding: 10px 12px; text-align: center; }
    .phase-chip .pc-name { font-size: 11px; font-weight: 700; color: var(--ts); text-transform: uppercase; letter-spacing: .06em; }
    .phase-chip .pc-h { font-size: 12px; color: var(--ts); margin: 3px 0; }
    .phase-chip .pc-price { font-size: 17px; font-weight: 800; color: var(--r); }
    .price-total-row { border-top: 1px solid var(--rm); padding-top: 12px; display: flex; justify-content: space-between; align-items: baseline; }
    .price-total-lbl { font-size: 13px; color: var(--tm); }
    .price-total-val { font-size: 28px; font-weight: 800; color: var(--r); letter-spacing: -1px; }
    .price-range { font-size: 12px; color: var(--ts); margin-top: 4px; text-align: right; }
    .price-breakdown { background: #fff; border: 1px solid var(--b); border-radius: 8px; margin-top: 12px; overflow: hidden; }
    .bd-row { display: flex; justify-content: space-between; padding: 7px 12px; font-size: 12px; border-bottom: 1px solid var(--b); }
    .bd-row:last-child { border-bottom: none; font-weight: 700; }
    .bd-val { font-weight: 600; }
    /* ── BUTTONS ── */
    .btn-row { display: flex; justify-content: space-between; align-items: center; margin-top: 24px; gap: 10px; }
    .btn-back { background: #fff; border: 1.5px solid var(--b); color: var(--tm); font-family: var(--f); font-size: 14px; font-weight: 600; padding: 11px 20px; border-radius: 8px; cursor: pointer; transition: all .18s; }
    .btn-back:hover { border-color: var(--r); color: var(--r); }
    .btn-next { background: var(--r); border: none; color: #fff; font-family: var(--f); font-size: 14px; font-weight: 700; padding: 11px 26px; border-radius: 8px; cursor: pointer; transition: background .18s; }
    .btn-next:hover { background: var(--rl); }
    /* ── RESULT ── */
    #step-result { display: none; }
    .res-tabs { display: flex; gap: 7px; margin-bottom: 18px; flex-wrap: wrap; }
    .res-tab { padding: 8px 16px; border-radius: 7px; border: 1.5px solid var(--b); background: #fff; font-family: var(--f); font-size: 13px; font-weight: 600; cursor: pointer; color: var(--tm); transition: all .18s; }
    .res-tab.active { border-color: var(--r); background: var(--r); color: #fff; }
    .res-panel { display: none; }
    .res-panel.active { display: block; }
    .email-box { background: #fff; border: 1px solid var(--b); border-radius: var(--rad); overflow: hidden; box-shadow: var(--sh); }
    .email-hd { background: var(--bgs); padding: 14px 18px; border-bottom: 1px solid var(--b); }
    .email-hd p { font-size: 12px; color: var(--tm); margin-bottom: 3px; }
    .email-hd strong { font-size: 14px; }
    .email-body { padding: 24px; font-size: 14px; line-height: 1.7; white-space: pre-wrap; }
    .email-foot { padding: 14px 18px; border-top: 1px solid var(--b); display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
    .email-hint { font-size: 11px; color: var(--ts); width: 100%; margin-top: 2px; }
    .proj-box { background: #fff; border: 1px solid var(--b); border-radius: var(--rad); overflow: hidden; box-shadow: var(--sh); }
    .proj-hd { background: var(--r); color: #fff; padding: 14px 18px; }
    .proj-hd h3 { font-size: 15px; font-weight: 700; }
    .proj-hd p { font-size: 12px; opacity: .85; margin-top: 3px; }
    .phase-block { padding: 18px; border-bottom: 1px solid var(--b); }
    .phase-block:last-child { border-bottom: none; }
    .phase-title { font-size: 12px; font-weight: 700; color: var(--r); text-transform: uppercase; letter-spacing: .06em; margin-bottom: 10px; display: flex; align-items: center; gap: 8px; }
    .phase-title::after { content: ''; flex: 1; height: 1px; background: var(--rm); }
    .task-row { display: flex; gap: 9px; padding: 5px 0; font-size: 13px; border-bottom: 1px solid var(--bgs); }
    .task-row:last-child { border-bottom: none; }
    .task-num { width: 18px; height: 18px; border-radius: 4px; background: var(--rp); color: var(--r); font-size: 10px; font-weight: 800; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 1px; }
    .task-name { font-weight: 600; color: var(--t); }
    .task-desc { font-size: 12px; color: var(--ts); margin-top: 1px; }
    .action-btn { display: inline-flex; align-items: center; gap: 6px; padding: 9px 16px; border-radius: 7px; font-family: var(--f); font-size: 13px; font-weight: 600; cursor: pointer; text-decoration: none; transition: all .18s; border: none; }
    .action-btn.pri { background: var(--r); color: #fff; }
    .action-btn.pri:hover { background: var(--rl); }
    .action-btn.sec { background: #fff; border: 1.5px solid var(--b); color: var(--tm); }
    .action-btn.sec:hover { border-color: var(--r); color: var(--r); }
    .import-note { margin-top: 10px; padding: 10px 13px; background: #FFFBE6; border: 1px solid #F5D87A; border-radius: 8px; font-size: 12px; color: #7A6000; line-height: 1.55; }
    .toast { position: fixed; bottom: 22px; right: 22px; background: var(--r); color: #fff; padding: 11px 18px; border-radius: 9px; font-size: 14px; font-weight: 600; box-shadow: 0 6px 20px rgba(228,36,33,.3); transform: translateY(60px); opacity: 0; transition: all .3s; z-index: 999; }
    .toast.show { transform: translateY(0); opacity: 1; }
  </style>
</head>
<body>
<!-- HEADER -->
<header>
  <div class="nav-inner">
    <a href="https://www.karolinlinden.de" class="nav-logo" style="display:flex;align-items:center;gap:10px;text-decoration:none">
      <img src="https://www.karolinlinden.de/Logos/Bildschirmfoto%202026-01-16%20um%2015.57.41.png" alt="Linden Consulting"
           onerror="this.style.display='none';document.getElementById('logoFb').style.display='block'">
      <span id="logoFb" style="display:none">Linden Consulting</span>
    </a>
    <nav>
      <a href="https://www.karolinlinden.de/">Home</a>
      <a href="https://linden-tools.netlify.app">Tools</a>
      <a href="https://bookings.karolinlinden.de/#/erstgespraech" class="cta">Termin</a>
    </nav>
  </div>
</header>
<!-- HERO -->
<div class="hero">
  <div class="hero-left">
    <div class="eyebrow">Erstgespräch · Linden Consulting</div>
    <h1>Digitale Abläufe,<br/><em>die wirklich laufen.</em></h1>
    <div class="hero-badge" id="heroBadge">
      <span class="lbl">Gespräch mit:</span>&nbsp;–
    </div>
  </div>
  <div class="hero-right">
    <img src="https://www.karolinlinden.de/Logos/Bildschirmfoto%202026-01-16%20um%2015.57.41.png" alt="Linden Consulting"
         onerror="this.style.display='none'">
    <p>Karolin Linden · Frankfurt am Main</p>
  </div>
</div>
<!-- PROGRESS -->
<div class="prog-bar" id="progBar">
  <div class="prog-inner" id="progInner">
    <div class="prog-step"><div class="prog-dot active" id="pd1">1</div><span class="prog-lbl active" id="pl1">Kundendaten</span></div>
    <div class="prog-line" id="pline1"></div>
    <div class="prog-step"><div class="prog-dot" id="pd2">2</div><span class="prog-lbl" id="pl2">Ist-Situation</span></div>
    <div class="prog-line" id="pline2"></div>
    <div class="prog-step"><div class="prog-dot" id="pd3">3</div><span class="prog-lbl" id="pl3">Scope & Ziele</span></div>
    <div class="prog-line" id="pline3"></div>
    <div class="prog-step"><div class="prog-dot" id="pd4">4</div><span class="prog-lbl" id="pl4">Wertsäule & Angebot</span></div>
    <div class="prog-line" id="pline4"></div>
    <div class="prog-step"><div class="prog-dot" id="pd5">5</div><span class="prog-lbl" id="pl5">Notizen</span></div>
  </div>
</div>
<div class="wrap">
<!-- ══ SCHRITT 1: KUNDENDATEN ══════════════════════════════════════════ -->
<div class="panel active" id="step-1">
  <div class="card">
    <h2 class="card-title">Kundendaten</h2>
    <div class="card-sub">Kontaktinfos und Unternehmenseckdaten</div>
    <div class="g2">
      <div class="field"><label>Ansprechpartner *</label><input type="text" id="kName" placeholder="Max Mustermann"></div>
      <div class="field"><label>Funktion / Rolle</label><input type="text" id="kRolle" placeholder="Geschäftsführer …"></div>
      <div class="field"><label>E-Mail *</label><input type="email" id="kMail" placeholder="max@firma.de"></div>
      <div class="field"><label>Telefon</label><input type="tel" id="kTel" placeholder="+49 …"></div>
    </div>
    <div class="sec">Unternehmen</div>
    <div class="g2">
      <div class="field"><label>Firmenname *</label><input type="text" id="kFirma" placeholder="Muster GmbH"></div>
      <div class="field"><label>Website</label><input type="text" id="kWeb" placeholder="www.firma.de"></div>
      <div class="field">
        <label>Branche * <small>(bestimmt Preismultiplikator)</small></label>
        <select id="kBranche" onchange="calcAngebot()">
          <option value="">— bitte wählen —</option>
          <option value="2.2">Biotech / Life Sciences  ×2,2</option>
          <option value="2.0">Pharma / Medizin  ×2,0</option>
          <option value="1.9">Finance / Versicherung  ×1,9</option>
          <option value="1.7">IT / Software  ×1,7</option>
          <option value="1.5">Immobilien  ×1,5</option>
          <option value="1.4">Industrie / Maschinenbau  ×1,4</option>
          <option value="1.2">Handel / E-Commerce  ×1,2</option>
          <option value="1.1">Handwerk  ×1,1</option>
          <option value="1.0">Gastronomie / Hotel  ×1,0</option>
          <option value="0.85">NGO / Verein  ×0,85</option>
          <option value="0.9">Fitness / Wellness  ×0,9</option>
          <option value="1.0">Bildung / Coaching  ×1,0</option>
        </select>
      </div>
      <div class="field">
        <label>Jahresumsatz * <small>(bestimmt Preismultiplikator)</small></label>
        <select id="kUmsatz" onchange="calcAngebot()">
          <option value="">— bitte wählen —</option>
          <option value="0.75">unter 250.000 €  ×0,75</option>
          <option value="0.95">250.000 – 1 Mio. €  ×0,95</option>
          <option value="1.2">1 Mio. – 5 Mio. €  ×1,2</option>
          <option value="1.55">5 Mio. – 20 Mio. €  ×1,55</option>
          <option value="2.0">20 Mio. – 100 Mio. €  ×2,0</option>
          <option value="2.6">über 100 Mio. €  ×2,6</option>
        </select>
      </div>
      <div class="field"><label>Mitarbeiterzahl</label>
        <select id="kMA">
          <option value="">—</option><option>1–5</option><option>6–10</option>
          <option>11–25</option><option>26–50</option><option>51–100</option><option>über 100</option>
        </select>
      </div>
      <div class="field"><label>Standort</label><input type="text" id="kOrt" placeholder="Frankfurt am Main"></div>
    </div>
    <div class="sec">Gespräch</div>
    <div class="g2">
      <div class="field"><label>Datum</label><input type="date" id="kDatum"></div>
      <div class="field"><label>Kanal</label>
        <select id="kKanal"><option>Online (Video)</option><option>Telefon</option><option>Vor Ort</option></select>
      </div>
    </div>
  </div>
  <div class="btn-row"><div></div><button class="btn-next" onclick="go(2)">Weiter: Ist-Situation →</button></div>
</div>
<!-- ══ SCHRITT 2: IST-SITUATION ════════════════════════════════════════ -->
<div class="panel" id="step-2">
  <div class="card">
    <h2 class="card-title">Aktuelle Situation</h2>
    <div class="card-sub">Welche Tools laufen – und wo drückt der Schuh?</div>
    <div class="sec">Aktuelle Tools</div>
    <div class="chk-grid" id="toolsGrid"></div>
    <div class="field" style="margin-top:10px"><label>Weitere Tools <small>(optional)</small></label>
      <input type="text" id="toolsExtra" placeholder="Lexware, DATEV, eigene DB …"></div>
    <div class="sec">Hauptprobleme</div>
    <div class="chk-grid" id="problemsGrid"></div>
    <div class="field" style="margin-top:14px"><label>Was läuft schon gut?</label>
      <textarea id="gutLaeuft" rows="2" placeholder="Was funktioniert bereits zuverlässig …"></textarea></div>
    <div class="field"><label>Größte Baustelle in einem Satz</label>
      <input type="text" id="baustelle" placeholder="„Wir verlieren zu viel Zeit mit manueller Datenpflege.“"></div>
  </div>
  <div class="btn-row"><button class="btn-back" onclick="go(1)">← Zurück</button><button class="btn-next" onclick="go(3)">Weiter: Scope →</button></div>
</div>
<!-- ══ SCHRITT 3: SCOPE & ZIELE ════════════════════════════════════════ -->
<div class="panel" id="step-3">
  <div class="card">
    <h2 class="card-title">Scope & Ziele</h2>
