function escapeHtml(str){
  return String(str).replace(/[&<>"']/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}
function buildProject(d){
  const phases=[
    {key:'p1',title:'Phase 1 – Fundament',show:d.h1>0},
    {key:'p2',title:'Phase 2 – PoC & Rollout',show:d.h2>0},
    {key:'p3',title:'Phase 3 – Skalierung',show:d.h3>0},
  ].filter(p=>p.show);
  const el=document.getElementById('projBox');
  el.innerHTML=`
    <div class="proj-hd">
      <h3>${escapeHtml(d.firma)} – Zoho-Digitalisierung</h3>
      <p>${d.branche!='–'?escapeHtml(d.branche)+' | ':''}${d.ma?escapeHtml(d.ma)+' MA | ':''}Start: ${d.startDate?deDate(d.startDate):'nach Vereinbarung'}</p>
    </div>
    ${phases.map(ph=>`
      <div class="phase-block">
        <div class="phase-title">${ph.title}</div>
        ${PHASE_TASKS[ph.key].map((t,i)=>`
          <div class="task-row">
            <div class="task-num">${i+1}</div>
            <div><div class="task-name">${t.n}</div><div class="task-desc">${t.d}</div></div>
          </div>`).join('')}
      </div>`).join('')}`;
  window._projData={d,phases};
}
