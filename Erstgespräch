<script>
// ═══════════════════════════════════════ DATA ════════════════════════════
const TOOLS = [
  'Microsoft Excel','Microsoft Word','Microsoft Outlook','Microsoft Teams',
  'Google Workspace','Lexware','DATEV','SAP','Personio',
  'Trello / Asana','Slack','WhatsApp (geschäftlich)','Papier / Ordner',
  'Eigene Datenbank / Access','Kein CRM vorhanden'
];
const PROBLEMS = [
  'Doppelarbeit & manuelle Datenpflege','Fehlende Transparenz',
