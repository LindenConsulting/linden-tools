  'DSGVO-Unsicherheiten','Tools werden nicht konsequent genutzt',
  'Hohe Softwarekosten ohne Nutzen','Schwieriges Onboarding'
];
const BEREICHE = [
  'Vertrieb & CRM','Dokumentenmanagement',
  'Projektmanagement','Produktion / Abläufe',
  'Buchhaltung & Finanzen','HR & Personal',
  'Reporting & Dashboards','Einkauf & Lager',
  'Forschung & Entwicklung','Marketing',
  'Schulungen & Wissen','Website & Online'
];
const ZOHO = [
  {e:'',n:'Zoho CRM'},{e:'',n:'Zoho WorkDrive'},{e:'',n:'Zoho Projects'},
  {e:'',n:'Zoho Analytics'},{e:'',n:'Zoho Books'},{e:'',n:'Zoho Inventory'},
  {e:'',n:'Zoho People'},{e:'',n:'Zoho Creator'},{e:'',n:'Zoho Mail'},
  {e:'',n:'Zoho Campaigns'},{e:'',n:'Zoho Cliq'},{e:'',n:'Zoho Flow'},
  {e:'',n:'Zoho Sign'},{e:'',n:'Zoho One'}
];
const NEXTSTEPS = [
  'Angebot per E-Mail zusenden','Detailliertes Konzept ausarbeiten',
  'Demo / Präsentation vereinbaren','Kostenvergleich erstellen',
  'Referenzprojekt vorstellen','ROI-Kalkulation erstellen',
  'Vertrag vorbereiten','Kickoff-Termin festlegen'
];
const PHASE_TASKS = {
  p1:[
    {n:'Ist-Analyse & Ordnerstruktur',d:'Analyse bestehender Strukturen, Ablage und Workflows'},
    {n:'Berechtigungskonzept erstellen',d:'Rollen, Zugriffsrechte, E-Mail-Richtlinien definieren'},
    {n:'Rollen & Funktionen definieren',d:'Verantwortlichkeiten und Zeiterfassung klären'},
    {n:'Wissensdokumentation starten',d:'Internes Wissen sichern – WorkDrive als Wissensdatenbank'},
    {n:'Zoho One einrichten (2 Lizenzen)',d:'Start mit Admin- und GF-Lizenz, Grundkonfiguration'},
    {n:'PoC erstes Zoho-Modul',d:'Proof of Concept für das priorisierte Hauptmodul'},
  ],
  p2:[
    {n:'PoC auswerten & anpassen',d:'Erkenntnisse einfließen lassen, Konfiguration finalisieren'},
    {n:'Rollout Haupt-Modul',d:'Unternehmensweit ausrollen inkl. Datenmigration'},
    {n:'Weitere Module konfigurieren',d:'CRM, DMS, PM-Board, Buchhaltung je nach Scope'},
    {n:'Schulungen Mitarbeitende',d:'Praxisnahe Schulungen zu allen relevanten Modulen'},
    {n:'Superuser schulen',d:'Eigenständige Pflege, Admin-Rechte, Design-Anpassungen'},
    {n:'Prozesse dokumentieren',d:'SOPs im WorkDrive ablegen'},
  ],
  p3:[
    {n:'Reporting & Dashboards',d:'Zoho Analytics – KPIs und Managementreports'},
    {n:'Automatisierungen aufbauen',d:'Zoho Flow – wiederkehrende Abläufe automatisieren'},
    {n:'Weitere Skalierungsmodule',d:'Inventory, Creator, People – je nach Scope'},
    {n:'Onboarding-Prozess digitalisieren',d:'Strukturiertes digitales Onboarding entwickeln'},
    {n:'Abschluss & Feintuning',d:'Rücksprache mit allen Beteiligten, letzte Anpassungen'},
  ]
};
// ═══════════════════════════════════════ RENDER ══════════════════════════
function mkChecks(containerId, items, prefix){
  const el = document.getElementById(containerId);
  items.forEach((item,i)=>{
    const lbl = document.createElement('label');
    lbl.className='chk-item'; lbl.htmlFor=`${prefix}_${i}`;
    lbl.innerHTML=`<input type="checkbox" id="${prefix}_${i}" value="${item}">
      <div class="chk-box"></div><span class="chk-lbl">${item}</span>`;
    lbl.querySelector('input').addEventListener('change',function(){
      lbl.classList.toggle('sel',this.checked);
    });
    el.appendChild(lbl);
  });
}
function mkZoho(){
  const el=document.getElementById('zohoGrid');
  ZOHO.forEach((m,i)=>{
    const lbl=document.createElement('label');
    lbl.className='pill'; lbl.innerHTML=`<input type="checkbox" id="zm_${i}" value="${m.n}"><span>${m.e}</span><span>${m.n}</span>`;
    lbl.querySelector('input').addEventListener('change',function(){lbl.classList.toggle('sel',this.checked);});
    el.appendChild(lbl);
  });
}
// ═══════════════════════════════════════ NAVIGATION ══════════════════════
function go(n){
  document.querySelectorAll('.panel').forEach(p=>p.classList.remove('active'));
  const p=document.getElementById(`step-${n}`);
  if(p) p.classList.add('active');
  for(let i=1;i<=5;i++){
    document.getElementById(`pd${i}`).className='prog-dot'+(i===n?' active':i<n?' done':'');
    document.getElementById(`pl${i}`).className='prog-lbl'+(i===n?' active':'');
    if(i<5) document.getElementById(`pline${i}`).className='prog-line'+(i<n?' done':'');
  }
  // Update multiplier display when entering step 4
  if(n===4) updateMultDisplay();
  window.scrollTo({top:0,behavior:'smooth'});
}
// ═══════════════════════════════════════ WERTSÄULE + KALKULATION ═════════
const BRANCHE_NAMES = {
  '2.2':'Biotech / Life Sciences','2.0':'Pharma / Medizin','1.9':'Finance / Versicherung',
  '1.7':'IT / Software','1.5':'Immobilien','1.4':'Industrie / Maschinenbau',
  '1.2':'Handel / E-Commerce','1.1':'Handwerk','1.0':'Gastronomie / Hotel / Bildung',
  '0.85':'NGO / Verein','0.9':'Fitness / Wellness'
};
const UMSATZ_NAMES = {
  '0.75':'unter 250.000 €','0.95':'250.000 – 1 Mio. €','1.2':'1 – 5 Mio. €',
  '1.55':'5 – 20 Mio. €','2.0':'20 – 100 Mio. €','2.6':'über 100 Mio. €'
};
function updateMultDisplay(){
  const bv = document.getElementById('kBranche').value;
  const uv = document.getElementById('kUmsatz').value;
  document.getElementById('mcBrancheVal').textContent = bv ? BRANCHE_NAMES[bv]||'–' : '← aus Schritt 1 wählen';
  document.getElementById('mcBrancheMult').textContent = bv ? '×'+bv : '–';
  document.getElementById('mcUmsatzVal').textContent   = uv ? UMSATZ_NAMES[uv]||'–' : '← aus Schritt 1 wählen';
  document.getElementById('mcUmsatzMult').textContent  = uv ? '×'+uv : '–';
}
function calcAngebot(){
  updateMultDisplay();
  const rate = +document.getElementById('anStunde').value || 120;
  const bm   = +(document.getElementById('kBranche').value) || 1;
  const um   = +(document.getElementById('kUmsatz').value)  || 1;
  const h1   = +document.getElementById('sl1').value;
  const h2   = +document.getElementById('sl2').value;
  const h3   = +document.getElementById('sl3').value;
  document.getElementById('sv1').textContent = h1+' h';
  document.getElementById('sv2').textContent = h2+' h';
  document.getElementById('sv3').textContent = h3+' h';
  const mult = bm * um;
  const p1 = h1*rate*mult, p2 = h2*rate*mult, p3 = h3*rate*mult;
  const total = p1+p2+p3;
  const phases = [['Phase 1',h1,p1],['Phase 2',h2,p2],['Phase 3',h3,p3]].filter(x=>x[1]>0);
  document.getElementById('pricePhases').innerHTML = phases.map(([n,h,p])=>`
    <div class="phase-chip">
      <div class="pc-name">${n}</div>
      <div class="pc-h">${h} h</div>
      <div class="pc-price">${fmt(p)}</div>
    </div>`).join('');
  if(total>0){
    document.getElementById('priceTotal').textContent = fmt(total);
    document.getElementById('priceRange').textContent = `Spanne: ${fmt(total*.85)} – ${fmt(total*1.2)}`;
    document.getElementById('priceBreakdown').innerHTML = `
      <div class="bd-row"><span>Basispreis (${h1+h2+h3} h × ${rate} €)</span><span class="bd-val">${fmt((h1+h2+h3)*rate)}</span></div>
      <div class="bd-row"><span>Branchenfaktor</span><span class="bd-val">×${bm.toFixed(2)}</span></div>
      <div class="bd-row"><span>Umsatzfaktor</span><span class="bd-val">×${um.toFixed(2)}</span></div>
      <div class="bd-row"><span>Gesamtinvestition (Netto)</span><span class="bd-val" style="color:var(--r)">${fmt(total)}</span></div>`;
  } else {
    document.getElementById('priceTotal').textContent='–';
    document.getElementById('priceRange').textContent='';
    document.getElementById('priceBreakdown').innerHTML='';
  }
}
// ═══════════════════════════════════════ VALIDIERUNG ═════════════════════
function validateRequired(){
  const required = [
    ['kName','Ansprechpartner'],
    ['kMail','E-Mail'],
    ['kFirma','Firmenname'],
    ['kBranche','Branche'],
    ['kUmsatz','Jahresumsatz'],
  ];
  document.querySelectorAll('.invalid').forEach(el=>el.classList.remove('invalid'));
  const missing = [];
  required.forEach(([id,label])=>{
    const el = document.getElementById(id);
    if(!el.value.trim()){ missing.push(label); el.classList.add('invalid'); }
  });
  return missing;
}
// ═══════════════════════════════════════ GENERATE ════════════════════════
function generate(){
  const missing = validateRequired();
  if(missing.length){
    toast('Bitte zuerst ausfüllen: '+missing.join(', '));
    go(1);
    return;
  }
  const bSel = document.getElementById('kBranche');
  const uSel = document.getElementById('kUmsatz');
  const bm = +(bSel.value)||1, um = +(uSel.value)||1;
  const rate = +document.getElementById('anStunde').value||120;
  const h1=+document.getElementById('sl1').value, h2=+document.getElementById('sl2').value, h3=+document.getElementById('sl3').value;
  const mult=bm*um;
  const p1=h1*rate*mult, p2=h2*rate*mult, p3=h3*rate*mult, total=p1+p2+p3;
  const d={
    name:v('kName'),rolle:v('kRolle'),mail:v('kMail'),tel:v('kTel'),
    firma:v('kFirma'),web:v('kWeb'),ort:v('kOrt'),
    branche: bSel.value ? (bSel.options[bSel.selectedIndex]?.text?.split('  ')[0]||'–') : '–',
    umsatz:  uSel.value ? (uSel.options[uSel.selectedIndex]?.text?.split('  ')[0]||'–') : '–',
    ma:v('kMA'),datum:v('kDatum'),kanal:v('kKanal'),
    tools:   checked('tools',TOOLS), toolsExtra:v('toolsExtra'),
    problems:checked('problems',PROBLEMS),
    gutLaeuft:v('gutLaeuft'),baustelle:v('baustelle'),
    bereiche:checked('bereiche',BEREICHE),
    zohoMods:ZOHO.filter((_,i)=>document.getElementById(`zm_${i}`)?.checked).map(m=>m.n),
    startDate:v('startDate'),zeitrahmen:v('zeitrahmen'),entscheider:v('entscheider'),
    zahlungsmodell:v('zahlungsmodell'),
    bm,um,rate,h1,h2,h3,p1,p2,p3,total,
    kern:v('nKern'),anforderungen:v('nAnforderungen'),fragen:v('nFragen'),
    sonstige:v('nSonstige'),nextContact:v('nNextContact'),
    nextSteps:checked('next',NEXTSTEPS),
  };
  buildEmail(d); buildProject(d); buildBrief(d);
  document.querySelectorAll('.panel').forEach(p=>p.classList.remove('active'));
  document.getElementById('progBar').style.display='none';
  document.getElementById('step-result').style.display='block';
  window.scrollTo({top:0,behavior:'smooth'});
}
function buildEmail(d){
  const phases=[];
  if(d.h1>0) phases.push(`Phase 1 – Fundament      ${d.h1} h | ${fmt(d.p1)}`);
  if(d.h2>0) phases.push(`Phase 2 – PoC & Rollout  ${d.h2} h | ${fmt(d.p2)}`);
  if(d.h3>0) phases.push(`Phase 3 – Skalierung     ${d.h3} h | ${fmt(d.p3)}`);
  const subj=`Dein individuelles Angebot – Linden Consulting × ${d.firma}`;
  const body=`Hallo ${d.name.split(' ')[0]||d.name},
vielen Dank für unser Gespräch${d.datum?' am '+deDate(d.datum):''} – es hat mir viel Klarheit gegeben.
Wie versprochen, hier mein individuelles Angebot für ${d.firma}.
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
