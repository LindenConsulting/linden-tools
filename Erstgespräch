  const msg=`Bitte lege jetzt in Zoho Projects (Portal-ID 20107761440) ein neues Projekt an mit diesen Daten:
Projektname: ${d.firma} – Digitale Geschäftsabläufe
Beschreibung: ${d.branche!='–'?'Branche: '+d.branche+' | ':''
