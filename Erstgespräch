function dlCSV(){
  if(!window._projData) return;
  const {d,phases}=window._projData;
  const start=d.startDate?new Date(d.startDate):new Date();
  const off={p1:0,p2:90,p3:180};
  const names={p1:'Phase 1 – Fundament',p2:'Phase 2 – PoC & Rollout',p3:'Phase 3 – Skalierung'};
  let rows=[['AUFGABE-NAME','AUFGABE-BESCHREIBUNG','AUFGABENLISTENNAME','BESITZER','STARTDATUM','FÄLLIGKEITSDATUM','PRIORITÄT','Spezifischer Status']];
  phases.forEach(ph=>{
    PHASE_TASKS[ph.key].forEach((t,i)=>{
      const s=new Date(start); s.setDate(s.getDate()+off[ph.key]+i*5);
      const e=new Date(s); e.setDate(e.getDate()+4);
      rows.push([t.n,t.d,names[ph.key],'Karolin Linden',fmtD(s),fmtD(e),i===0?'Hoch':'Normal','Offen']);
    });
  });
  const csv=rows.map(r=>r.map(c=>`"${String(c).replace(/"/g,'""')}"`).join(',')).join('\n');
  const a=document.createElement('a');
  a.href=URL.createObjectURL(new Blob(['﻿'+csv],{type:'text/csv;charset=utf-8'}));
  a.download=`Zoho_${d.firma.replace(/\s+/g,'_')}.csv`; a.click();
  toast('CSV heruntergeladen ✓');
}
